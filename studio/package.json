{
  "name": "envelope-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Renders Back of the Envelope shorts from JSON specs: HTML/CSS look kits, seeked frame by frame in Chromium, encoded with ffmpeg, with a synthesised music + SFX soundtrack (src/sound).",
  "type": "module",
  "scripts": {
    "render": "node src/cli.mjs render",
    "check": "node src/cli.mjs check",
    "stills": "node src/cli.mjs stills",
    "audio": "node src/cli.mjs audio",
    "sound": "node src/cli.mjs sound",
    "audit": "node src/cli.mjs audit",
    "sound:verify": "node src/cli.mjs verify",
    "sound:units": "node src/cli.mjs verify --units-only --cues test/fixtures/cues.json",
    "sound:pending": "node src/cli.mjs verify --pending",
    "sound:baseline": "node src/cli.mjs verify --write-baseline test/fixtures/sound-baseline.sha256",
    "sound:tempo-table": "node sound/tools/tempo-table.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "playwright": "1.56.1"
  }
}
