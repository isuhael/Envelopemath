{
  "name": "envelope-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Back of the Envelope — renders 9:16 'Envelope Math' teaser animatics from JSON specs",
  "type": "module",
  "bin": {
    "envelope-render": "src/cli.js"
  },
  "scripts": {
    "check": "node src/cli.js check specs/[0-9]*.json",
    "sheets": "node src/cli.js sheet specs/[0-9]*.json -o out/sheets/",
    "render": "node src/cli.js render specs/[0-9]*.json -o out/",
    "test": "node --test test/*.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@napi-rs/canvas": "^1.0.10"
  }
}
