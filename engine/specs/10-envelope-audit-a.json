   "end": 9.2,
   "text": "True part first: business meals really are deductible."
  },
  {
   "t": 9.2,
   "end": 10.8,
   "text": "But free? Two problems."
  },
  {
   "t": 10.8,
   "end": 14.0,
   "text": "One: meals are capped at 50%. So $50.",
   "say": "One: meals are capped at fifty percent. So fifty bucks."
  },
  {
   "t": 14.0,
   "end": 15.7,
   "text": "Two: a deduction isn't a refund."
