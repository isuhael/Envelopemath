    {"t": 12.7, "end": 14.7, "text": "Call it 8 paychecks. 16 weeks.", "say": "Call it eight paychecks. Sixteen weeks."},
    {"t": 15.1, "end": 16.4, "text": "Except that's the sticker."},
    {"t": 16.5, "end": 19.3, "text": "Texas sales tax: up to 8.25%.", "say": "Texas sales tax: up to eight and a quarter percent."},
