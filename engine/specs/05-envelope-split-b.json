    {"t": 22.6, "end": 24.5, "text": "$12.40 short.", "say": "Twelve forty short."},
    {"t": 24.8, "end": 27.5, "text": "A median paycheck covers it in 3.", "say": "A median paycheck covers it in three."},
    {"t": 27.6, "end": 29.0, "text": "Minimum wage? 9 paychecks.", "say": "Minimum wage? Nine paychecks."},
