      "text": "$50,000, at 1 in 913,000: 5 cents."
    },
    {
      "t": 16.6,
      "end": 19.5,
      "text": "Less than the $4 prize!"
    },
    {
      "t": 19.6,
      "end": 22.5,
      "text": "A million bucks: 9 cents. 32 cents so far."
